<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Payment"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Request for Payment" processRef="Process_Payment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Payment" name="Request for Payment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestPayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Admin">
        <bpmn:flowNodeRef>Task_CheckRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandlePayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_Start_Request</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_RequestPayment" name="Request Payment">
      <bpmn:incoming>Flow_Start_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Check</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckRequest" name="Check Request">
      <bpmn:incoming>Flow_Request_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Gateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Approved?">
      <bpmn:incoming>Flow_Check_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ApproveRequest" name="Approve Request">
      <bpmn:incoming>Flow_Gateway_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_Handle</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RejectRequest" name="Reject Request">
      <bpmn:incoming>Flow_Gateway_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_HandlePayment" name="Handle Payment">
      <bpmn:incoming>Flow_Approve_Handle</bpmn:incoming>
      <bpmn:outgoing>Flow_Handle_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Approved" name="Payment Done">
      <bpmn:incoming>Flow_Handle_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:incoming>Flow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Request" sourceRef="StartEvent_1" targetRef="Task_RequestPayment" />
    <bpmn:sequenceFlow id="Flow_Request_Check" sourceRef="Task_RequestPayment" targetRef="Task_CheckRequest" />
    <bpmn:sequenceFlow id="Flow_Check_Gateway" sourceRef="Task_CheckRequest" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Gateway_Approve" name="yes" sourceRef="Gateway_Decision" targetRef="Task_ApproveRequest" />
    <bpmn:sequenceFlow id="Flow_Gateway_Reject" name="no" sourceRef="Gateway_Decision" targetRef="Task_RejectRequest" />
    <bpmn:sequenceFlow id="Flow_Approve_Handle" sourceRef="Task_ApproveRequest" targetRef="Task_HandlePayment" />
    <bpmn:sequenceFlow id="Flow_Handle_End" sourceRef="Task_HandlePayment" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_Reject_End" sourceRef="Task_RejectRequest" targetRef="EndEvent_Rejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="50" width="900" height="490" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="150" y="50" width="870" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true">
        <dc:Bounds x="150" y="200" width="870" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="150" y="360" width="870" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="186" y="143" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestPayment_di" bpmnElement="Task_RequestPayment">
        <dc:Bounds x="260" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckRequest_di" bpmnElement="Task_CheckRequest">
        <dc:Bounds x="400" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="540" y="420" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="480" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveRequest_di" bpmnElement="Task_ApproveRequest">
        <dc:Bounds x="640" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectRequest_di" bpmnElement="Task_RejectRequest">
        <dc:Bounds x="640" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandlePayment_di" bpmnElement="Task_HandlePayment">
        <dc:Bounds x="780" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="940" y="400" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="922" y="443" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="940" y="490" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="915" y="533" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Request_di" bpmnElement="Flow_Start_Request">
        <di:waypoint x="216" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Request_Check_di" bpmnElement="Flow_Request_Check">
        <di:waypoint x="360" y="120" />
        <di:waypoint x="380" y="120" />
        <di:waypoint x="380" y="280" />
        <di:waypoint x="400" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_Gateway_di" bpmnElement="Flow_Check_Gateway">
        <di:waypoint x="500" y="280" />
        <di:waypoint x="520" y="280" />
        <di:waypoint x="520" y="445" />
        <di:waypoint x="540" y="445" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_Approve_di" bpmnElement="Flow_Gateway_Approve">
        <di:waypoint x="590" y="445" />
        <di:waypoint x="615" y="445" />
        <di:waypoint x="615" y="420" />
        <di:waypoint x="640" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="610" y="402" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_Reject_di" bpmnElement="Flow_Gateway_Reject">
        <di:waypoint x="565" y="470" />
        <di:waypoint x="565" y="510" />
        <di:waypoint x="640" y="510" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="599" y="492" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_Handle_di" bpmnElement="Flow_Approve_Handle">
        <di:waypoint x="740" y="420" />
        <di:waypoint x="760" y="420" />
        <di:waypoint x="760" y="280" />
        <di:waypoint x="780" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Handle_End_di" bpmnElement="Flow_Handle_End">
        <di:waypoint x="880" y="280" />
        <di:waypoint x="910" y="280" />
        <di:waypoint x="910" y="418" />
        <di:waypoint x="940" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_End_di" bpmnElement="Flow_Reject_End">
        <di:waypoint x="740" y="510" />
        <di:waypoint x="940" y="510" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
