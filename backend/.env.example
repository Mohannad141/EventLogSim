# Backend LLM provider keys — set ONE of these.
# llm_factory.py picks the first that is set, in this order:
#   1. DS_API_KEY      (DeepSeek, default)
#   2. OPENAI_API_KEY  (OpenAI gpt-4o)
#   3. GOOGLE_API_KEY  (Google Gemini)
#   4. GROQ_API_KEY    (Groq llama-3.3-70b)

DS_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# Database configuration
DATABASE_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/eventlogsim

